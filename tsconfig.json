{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "strict": true
  },
  "include": [
    "./src/**/*.ts",
    "./nodes/**/*.ts",
    "./credentials/**/*.ts",
    "./tests/**/*.ts"
  ],
  "exclude": ["./tests"]
}
